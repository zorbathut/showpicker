# Jellyfin: Dashboard -> API Keys -> "+"
JELLYFIN_URL=http://jellyfin.local:8096
JELLYFIN_API_KEY=

# Optional: which Jellyfin user to query as (defaults to the first admin)
# JELLYFIN_USER_ID=

# Optional: TMDB key (v3 API key or v4 read-access token) for titles not in your
# library, and extra backdrops/logos for ones that are. https://www.themoviedb.org/settings/api
TMDB_API_KEY=
